APP_ENV=local
APP_NAME=MarketMind Comment Intelligence API
API_PREFIX=/api
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg://marketmind:marketmind@localhost:5432/marketmind
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
TASK_STATUS_REDIS_URL=redis://localhost:6379/3
TASK_STATUS_TTL_SECONDS=86400

MODEL_PROVIDER=openai-compatible
MODEL_NAME=gpt-5.4-mini
REPORT_MODEL_NAME=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true
